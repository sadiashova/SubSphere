// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id                   String         @id @default(uuid())
  name                 String
  slug                 String         @unique
  thumbnail            String
  banner               String?
  category             String         // e.g. Beauty, Tech & Gadgets, Gourmet, Wellness, Lifestyle
  frequency            String         // Monthly, Bi-Monthly, Quarterly
  price                Float          // One-time price
  subscriptionPrice    Float          // Discounted subscription price
  description          String
  features             String         // JSON stringified array of features
  subscriptionBenefits String         // JSON stringified array of benefits
  rating               Float          @default(4.8)
  reviewCount          Int            @default(0)
  stock                Int            @default(100)
  isFeatured           Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  reviews              Review[]
  subscriptions        Subscription[]
  orderItems           OrderItem[]
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  avatar        String?
  phone         String?
  address       String?
  city          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  subscriptions Subscription[]
  reviews       Review[]
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  city            String
  totalAmount     Float
  discountAmount  Float       @default(0)
  paymentMethod   String      // "card", "bkash", "cash_on_delivery"
  paymentStatus   String      @default("PENDING") // PENDING, PAID, FAILED
  orderStatus     String      @default("PROCESSING") // PROCESSING, SHIPPED, DELIVERED, CANCELLED
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  isSubscribed Boolean @default(false)
  frequency   String?  // e.g. Monthly if subscribed
  quantity    Int      @default(1)
  unitPrice   Float
  subtotal    Float
}

model Subscription {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  plan         String   // MONTHLY, BI_MONTHLY, QUARTERLY
  status       String   @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED
  price        Float
  address      String
  customerName String
  customerEmail String
  startDate    DateTime @default(now())
  nextBilling  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  authorName String
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())
}

